/**
 * Pi Permissions Gate Extension (auto-generated by workspace-manager)
 *
 * Equivalent of Claude Code's permission system.
 * Confirms before running dangerous bash commands.
 */

import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { isToolCallEventType } from "@earendil-works/pi-coding-agent";

const DANGEROUS_PATTERNS = [
  /\brm\s+-rf\b/,
  /\brm\s+-r\b/,
  /\brm\s+.*\*\b/,
  /\brm\s+.*\/\b/,
  /\bsudo\s+rm\b/,
  /\bdd\s+if=/,
  /\bmkfs\b/,
  /\b:\(\)\{\s*:\|:\s*&\s*\};\s*:/,
  />\s*\/dev\/sd/,
  /\bgit\s+push\s+.*--force\b/,
  /\bgit\s+reset\s+--hard\b/,
  /\bkillall\s+-9\b/,
  /\bpkill\s+-9\b/,
];

const PROTECTED_PATHS = [
  ".env", ".env.local", ".env.production",
  "node_modules", ".git", "~/.ssh", "~/.gnupg",
];

export default function (pi: ExtensionAPI) {
  pi.on("tool_call", async (event, ctx) => {
    if (!isToolCallEventType("bash", event)) return;
    const command = event.input.command || "";

    for (const pattern of DANGEROUS_PATTERNS) {
      if (pattern.test(command)) {
        const ok = await ctx.ui.confirm(
          "⚠️ Dangerous Command",
          `This command looks destructive:\n\n${command.substring(0, 200)}${command.length > 200 ? "..." : ""}\n\nProceed?`
        );
        if (!ok) return { block: true, reason: "Blocked by permission gate (dangerous command)" };
        break;
      }
    }
  });

  pi.on("tool_call", async (event, ctx) => {
    if (isToolCallEventType("write", event)) {
      const filePath = event.input.path || "";
      const basename = filePath.split("/").pop() || "";
      for (const pp of PROTECTED_PATHS) {
        if (filePath.includes(pp) || basename === pp) {
          const ok = await ctx.ui.confirm(
            "🔒 Protected Path",
            `Writing to ${filePath} may be unsafe.\n\nProceed?`
          );
          if (!ok) return { block: true, reason: "Blocked by permission gate (protected path)" };
          break;
        }
      }
    }
  });

  pi.on("session_start", async (_event, ctx) => {
    ctx.ui.notify("Permission gate active - dangerous commands require confirmation", "info");
  });
}
