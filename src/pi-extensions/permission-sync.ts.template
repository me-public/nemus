/**
 * Pi Permission Sync Extension (auto-generated by nemus)
 *
 * Equivalent of Claude Code's sync-permissions.sh Stop hook.
 * Syncs project-level permissions to global settings on session shutdown.
 */

import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { spawn } from "node:child_process";

const SYNC_SCRIPT = "__SYNC_PERMISSIONS_SCRIPT__";

async function syncPermissions(): Promise<void> {
  return new Promise((resolve) => {
    const proc = spawn("bash", [SYNC_SCRIPT], {
      detached: true,
      stdio: "ignore",
      env: { ...process.env, CLAUDE_PROJECT_DIR: process.cwd() },
    });
    proc.unref();
    resolve();
  });
}

export default function (pi: ExtensionAPI) {
  pi.on("session_shutdown", async () => {
    try { await syncPermissions(); } catch { /* ignore */ }
  });

  pi.registerCommand("sync-permissions", {
    description: "Sync project permissions to global settings",
    handler: async (_args, ctx) => {
      try {
        await syncPermissions();
        ctx.ui.notify("Permissions synced to global settings", "success");
      } catch (error) {
        ctx.ui.notify(`Failed to sync permissions: ${error}`, "error");
      }
    },
  });
}
