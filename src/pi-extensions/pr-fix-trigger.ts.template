/**
 * Pi PR-Fix Trigger Extension (auto-generated by workspace-manager)
 *
 * Equivalent of Claude Code's check-pr-fix-trigger.sh PostToolUse hook.
 * Detects `gh pr create` in bash tool results, extracts the PR URL,
 * and injects a directive to monitor CI and address review comments.
 *
 * @managed workspace-manager
 */

import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { isBashToolResult } from "@earendil-works/pi-coding-agent";

const PR_URL_REGEX = /https:\/\/github\.com\/([^/]+)\/([^/]+)\/pull\/(\d+)/;

export default function (pi: ExtensionAPI) {
  pi.on("tool_result", async (event, ctx) => {
    // Only handle bash tool results
    if (!isBashToolResult(event)) return;

    // Check if the command was a `gh pr create`
    const command = String(event.input?.command ?? "");
    if (!command.includes("gh pr create")) return;

    // Extract PR URL and components from tool result content
    const resultText = Array.isArray(event.content)
      ? event.content
          .filter((c: { type: string }) => c.type === "text")
          .map((c: { text: string }) => c.text)
          .join("\n")
      : String(event.content ?? "");

    const match = resultText.match(PR_URL_REGEX);
    if (!match) return;

    const [prUrl, owner, repo, prNumber] = match;

    // Inject the PR-fix directive as a steering message
    const directive = buildPrFixDirective(prUrl, owner, repo, prNumber);

    pi.sendMessage(
      {
        customType: "pr-fix-trigger",
        content: directive,
        display: true,
      },
      { deliverAs: "steer", triggerTurn: true }
    );
  });
}

function buildPrFixDirective(
  prUrl: string,
  owner: string,
  repo: string,
  prNumber: string
): string {
  return `[PR-FIX-TRIGGER] Pull request created: ${prUrl}

You MUST now execute the following two-phase autonomous feedback loop. Do NOT skip any phase. Do NOT ask the user for permission to start — begin immediately.

═══════════════════════════════════════════════════════════════
 PHASE 1: CI MONITORING & FIXES
═══════════════════════════════════════════════════════════════

Monitor CircleCI for the PR. Run:
  gh pr checks ${prUrl} --watch

If checks fail:
1. Read the failing check details
2. Identify the root cause (test failure, lint error, build error, etc.)
3. Fix the code
4. Commit with message: "fix: address CI failure"
5. Push (never force-push)
6. Re-run: gh pr checks ${prUrl} --watch
7. Repeat up to 3 times

If checks pass → proceed to Phase 2.
If checks still fail after 3 attempts → STOP. Inform the user what failed and why manual help is needed.

═══════════════════════════════════════════════════════════════
 PHASE 2: PR REVIEW COMMENT MONITORING
═══════════════════════════════════════════════════════════════

Enter a comment monitoring loop (max 5 iterations):

For each iteration:
1. Fetch review comments using these two commands:
     gh api repos/${owner}/${repo}/pulls/${prNumber}/reviews
     gh api repos/${owner}/${repo}/pulls/${prNumber}/comments

2. Filter for actionable comments:
   - Ignore reviews with state APPROVED or DISMISSED
   - Focus on CHANGES_REQUESTED and COMMENTED reviews that have a non-empty body
   - Focus on inline comments (from /comments endpoint) that have not been resolved
   - Ignore comments authored by the PR author (yourself / bots)

3. If NO actionable comments are found → STOP. Report success: "No unresolved review comments. PR feedback loop complete."

4. If actionable comments ARE found:
   a. For each comment, read the referenced file and understand the context
   b. If the comment is clear and actionable (typo fix, style change, logic fix, add test, etc.) → make the change
   c. If the comment is ambiguous, requests major architectural changes, or you are unsure → ask the user for guidance on that specific comment before proceeding
   d. After addressing all clear comments, commit with message: "fix: address PR review comments"
   e. Push the commit (never force-push)
   f. Show the user a summary of what you changed and why

5. Track which comment IDs you saw in this iteration. If the SAME set of comment IDs appeared in the previous iteration (meaning no new comments, and your fixes haven't been acknowledged yet) → STOP. Report: "Previously seen comments already addressed. Waiting for reviewer to re-review."

6. Wait 120 seconds, then start the next iteration.

TERMINATION CONDITIONS (stop the loop if ANY of these are true):
- Phase 1 required manual intervention → stop after Phase 1
- No actionable comments found → stop (success)
- Same comment IDs as previous iteration → stop (already addressed)
- Max 5 iterations reached → stop and report summary of all changes made

SAFETY RULES:
- NEVER force-push
- NEVER rewrite git history
- After each commit, show the user what changed (files modified, brief description)
- For ambiguous or architectural comments, ASK the user before making changes
- If a comment asks to revert or undo your previous changes, do so carefully`;
}
