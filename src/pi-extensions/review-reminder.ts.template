/**
 * Pi Review Reminder Extension (auto-generated by workspace-manager)
 *
 * Equivalent of Claude Code's check-review-reminder.sh SessionStart hook.
 * Reminds user to review global permissions periodically.
 */

import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import * as fs from "node:fs";
import * as path from "node:path";
import * as os from "node:os";

const CACHE_DIR = path.join(os.homedir(), ".nemus");
const REVIEW_FILE = path.join(CACHE_DIR, "last-permission-review");
const REMINDER_FILE = path.join(CACHE_DIR, "last-permission-reminder");
const THIRTY_DAYS_MS = 30 * 24 * 60 * 60 * 1000;

function getLastTimestamp(filePath: string): number {
  try {
    const content = fs.readFileSync(filePath, "utf-8").trim();
    const epoch = new Date(content).getTime();
    return isNaN(epoch) ? 0 : epoch;
  } catch {
    return 0;
  }
}

export default function (pi: ExtensionAPI) {
  pi.on("session_start", async (_event, ctx) => {
    const reviewEpoch = getLastTimestamp(REVIEW_FILE);
    const reminderEpoch = getLastTimestamp(REMINDER_FILE);
    const latestEpoch = Math.max(reviewEpoch, reminderEpoch);
    const now = Date.now();

    if (latestEpoch === 0) {
      ctx.ui.notify(
        "[nemus] Your global permissions have never been reviewed. Run /review-permissions to audit them.",
        "warning"
      );
    } else {
      const daysSince = Math.floor((now - latestEpoch) / (24 * 60 * 60 * 1000));
      if (daysSince >= 30) {
        ctx.ui.notify(
          `[nemus] Your global permissions haven't been reviewed in ${daysSince} days. Run /review-permissions to clean up stale entries.`,
          "warning"
        );
      } else {
        return; // Recent — stay silent
      }
    }

    // Write reminder timestamp
    try {
      fs.mkdirSync(CACHE_DIR, { recursive: true });
      fs.writeFileSync(REMINDER_FILE, new Date().toISOString());
    } catch { /* ignore */ }
  });
}
