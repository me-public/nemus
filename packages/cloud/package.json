{
  "name": "@nemus-cli/cloud",
  "version": "0.1.1",
  "description": "Optional cloud/IaC runners for Nemus — run a workspace + coding agent on your own infrastructure. Vendor-neutral and provider-pluggable. Not required for local Nemus.",
  "keywords": [
    "nemus",
    "cloud",
    "iac",
    "terraform",
    "opentofu",
    "agent",
    "ci"
  ],
  "author": "Nemus contributors",
  "license": "MIT",
  "homepage": "https://github.com/me-public/nemus/tree/main/packages/cloud#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/me-public/nemus.git",
    "directory": "packages/cloud"
  },
  "bugs": {
    "url": "https://github.com/me-public/nemus/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nemus-cloud-agent": "dist/agent/cli.js",
    "nemus-cloud": "dist/cli/cloud.js"
  },
  "files": [
    "dist/**/*",
    "image/**/*",
    "iac/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e:kind": "npm run build && node e2e/kind-k8s-smoke.mjs",
    "e2e:docker": "npm run build && node e2e/docker-smoke.mjs",
    "e2e:image": "npm run build && docker build -f image/Dockerfile -t \"${NEMUS_E2E_IMAGE:-nemus-cloud-agent:e2e}\" ../.. && node e2e/agent-image-smoke.mjs",
    "clean": "rm -rf dist"
  }
}
